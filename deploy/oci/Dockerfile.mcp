FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /opt/nemoengine
COPY package.json ./
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund
COPY . .
RUN test -f mcp/sillytavern-server.mjs && test -f mcp/server.mjs
USER node
EXPOSE 8790 8787
CMD ["npm", "run", "start:sillytavern"]
